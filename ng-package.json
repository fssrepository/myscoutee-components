{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist",
  "lib": {
    "entryFile": "src/public-api.ts",
    "flatModuleFile": "components"
  },
  "assets": [
    "styles",
    {
      "input": "node_modules/@fontsource/roboto",
      "glob": "{300,400,500}.css",
      "output": "assets/fonts/roboto"
    },
    {
      "input": "node_modules/@fontsource/roboto/files",
      "glob": "*-{300,400,500}-normal.{woff,woff2}",
      "output": "assets/fonts/roboto/files"
    },
    {
      "input": "node_modules/@fontsource/roboto",
      "glob": "LICENSE",
      "output": "assets/fonts/roboto"
    },
    {
      "input": "node_modules/material-icons/iconfont",
      "glob": "{filled.css,material-icons.woff,material-icons.woff2}",
      "output": "assets/fonts/material-icons"
    },
    {
      "input": "node_modules/material-icons",
      "glob": "LICENSE",
      "output": "assets/fonts/material-icons"
    }
  ]
}

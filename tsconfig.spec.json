{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "declaration": false,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@fssrepository/myscoutee-components/core": [
        "./src/core-api.ts"
      ],
      "@fssrepository/myscoutee-components/forms": [
        "./src/forms-api.ts"
      ],
      "@fssrepository/myscoutee-components/foundation": [
        "./src/foundation-api.ts"
      ],
      "@fssrepository/myscoutee-components/date": [
        "./src/date-api.ts"
      ],
      "@fssrepository/myscoutee-components/cards": [
        "./src/cards-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "full"
  },
  "include": [
    "src/**/*.ts",
    "testing/**/*.ts"
  ],
  "exclude": []
}
